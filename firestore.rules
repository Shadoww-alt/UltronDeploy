rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAllowedEmailOrGuest() {
      return isAuthenticated() && (
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*@gmail\\.com$') ||
          request.auth.token.email.matches('.*@googlemail\\.com$')
        ))
      );
    }

    // Connection validation test document
    match /test/connection {
      allow read, write: if true;
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isAllowedEmailOrGuest();
      allow delete: if isOwner(userId);

      // User subcollections: conversations, tasks, settings, etc.
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) && isAllowedEmailOrGuest();
      }
    }
  }
}
